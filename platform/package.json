{
  "name": "platform",
  "private": true,
  "version": "0.1.0",
  "description": "Multi-tenant IoT asset and energy management platform on ThingsBoard CE",
  "type": "module",
  "packageManager": "pnpm@11.3.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "pnpm --filter @platform/shared build && pnpm -r --filter '!@platform/shared' build",
    "build:shared": "pnpm --filter @platform/shared build",
    "typecheck": "pnpm build:shared && pnpm -r typecheck",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "pnpm build:shared && pnpm -r test"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "@types/node": "^22.20.1",
    "eslint": "^9.39.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^16.4.0",
    "prettier": "^3.9.6",
    "typescript": "~5.9.3",
    "typescript-eslint": "~8.69.0",
    "vitest": "^4.0.0"
  }
}
