{
  "name": "@platform/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Platform API: tenants, assets, automations, live feed, CLI (Fastify)",
  "main": "dist/app.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "start": "fastify start -l info -a 0.0.0.0 -p 4000 dist/app.js",
    "dev": "tsx watch src/server.ts",
    "worker": "node dist/worker.js",
    "cli": "node dist/cli.js",
    "migrate": "drizzle-kit migrate",
    "generate": "drizzle-kit generate",
    "test": "vitest run && vitest run --config vitest.integration.config.ts",
    "test:integration": "vitest run --config vitest.integration.config.ts"
  },
  "dependencies": {
    "@fastify/autoload": "^6.5.0",
    "@fastify/cors": "^11.3.0",
    "@fastify/jwt": "^10.2.2",
    "@fastify/request-context": "^6.2.1",
    "@fastify/sensible": "^6.0.5",
    "@fastify/swagger": "^9.8.1",
    "@fastify/swagger-ui": "^5.2.6",
    "@platform/shared": "workspace:*",
    "@socket.io/redis-adapter": "^8.3.0",
    "bcryptjs": "^3.0.3",
    "bullmq": "^5.81.4",
    "commander": "^15.0.0",
    "drizzle-orm": "^0.45.2",
    "drizzle-zod": "^0.8.3",
    "fastify": "^5.12.3",
    "fastify-cli": "8.0.0",
    "fastify-plugin": "^5.1.0",
    "fastify-type-provider-zod": "^7.0.0",
    "ioredis": "^5.11.1",
    "nodemailer": "^10.0.1",
    "pdfkit": "^0.20.2",
    "pg": "^8.23.0",
    "pino": "^9.14.0",
    "pino-pretty": "^13.1.3",
    "socket.io": "^4.8.3",
    "undici": "^8.10.2",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@types/bcryptjs": "^3.0.0",
    "@types/node": "^22.20.1",
    "@types/nodemailer": "^8.0.1",
    "@types/pdfkit": "^0.17.6",
    "@types/pg": "^8.23.1",
    "drizzle-kit": "^0.31.10",
    "socket.io-client": "^4.8.3",
    "tsx": "^4.23.13",
    "typescript": "~5.9.3",
    "vitest": "^4.0.0"
  }
}
