# syntax=docker/dockerfile:1
# Build context: platform/. React Router SPA built with Vite, served by nginx.
FROM node:22-alpine AS base
RUN corepack enable && (corepack prepare pnpm@11.3.0 --activate || npm i -g pnpm@11)
WORKDIR /workspace

FROM base AS deps
COPY package.json pnpm-workspace.yaml pnpm-lock.yaml tsconfig.base.json ./
COPY shared/package.json shared/
COPY api/package.json api/
COPY simulator/package.json simulator/
COPY web/package.json web/
COPY e2e/package.json e2e/
RUN pnpm install --frozen-lockfile

FROM deps AS build
COPY shared/ shared/
COPY web/ web/
RUN pnpm --filter @platform/shared build \
 && pnpm --filter @platform/web build

FROM nginx:1.27-alpine AS runtime
COPY deploy/nginx.conf /etc/nginx/conf.d/default.conf
COPY --from=build /workspace/web/build/client/ /usr/share/nginx/html/
EXPOSE 80
