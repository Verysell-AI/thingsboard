# TLS front door for a server deployment (deploy/docker-compose.prod.yml). Environment comes from .env:
# PLATFORM_HOST (console, bare host), API_HOST (public API), ACME_EMAIL (certificate notices).
# Tenant hostnames need no configuration: a certificate is issued on the first visit, after the API
# confirms the hostname belongs to a tenant (GET /health/hostname?domain=...).
{
	email {$ACME_EMAIL}
	on_demand_tls {
		ask http://api:4000/health/hostname
	}
}

# Plain HTTP only redirects (ACME HTTP challenges are answered before this block applies)
http:// {
	redir https://{host}{uri} permanent
}

# Public API host: OpenAPI docs at /docs; tenant routes need X-Tenant-Key and a demo-mode tenant
{$API_HOST} {
	reverse_proxy api:4000
}

# The IoT core's own interface, for showing the device registry, rule chains and alarm rules beside the
# product. TB_HOST defaults to tb.localhost, which Caddy signs with its local CA and never takes to ACME;
# set it to a public hostname to expose the core on a server. Unlike tenant hostnames this block gets a
# managed certificate directly, so it does not pass through the on-demand check above.
{$TB_HOST} {
	reverse_proxy thingsboard:9090
}

# Platform console on the bare host and every tenant hostname
https:// {
	tls {
		on_demand
	}
	reverse_proxy web:80
}
