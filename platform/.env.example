# Local development credentials only. Copy to .env; never commit .env.

# ---- ThingsBoard (upstream image, unmodified) ----
TB_IMAGE=thingsboard/tb-node:4.2.1.1
# The core's own database (compose service tb-db, not exposed on the host): PostgreSQL with the
# TimescaleDB extension; the core stores timeseries in a hypertable (DATABASE_TS_TYPE=timescale)
TB_DB_IMAGE=timescale/timescaledb:2.24.0-pg16
TB_DB_NAME=thingsboard
TB_DB_USER=postgres
TB_DB_PASSWORD=change-me-tb-db
TB_HTTP_PORT=8090
TB_MQTT_PORT=1884
# Inside compose the API reaches ThingsBoard at http://thingsboard:9090
TB_URL=http://thingsboard:9090
TB_SYSADMIN_EMAIL=sysadmin@thingsboard.org
# provision changes the default sysadmin password ("sysadmin") to this value on first run
TB_SYSADMIN_PASSWORD=change-me-sysadmin
# Password for the per-tenant service accounts svc-api@<tenant>.demo and svc-dashboards@<tenant>.demo
TB_SERVICE_PASSWORD=change-me-service
# Domain suffix for tenant service accounts and dataset users (<user>@<tenant>.<TENANT_DOMAIN>)
TENANT_DOMAIN=demo

# ---- Hostnames ----
# Bare host of the platform console; new tenants default to <key>.<PLATFORM_HOST>
PLATFORM_HOST=localhost
# Server deployments only (deploy/docker-compose.prod.yml, selected by COMPOSE_FILE): public API host and
# the e-mail Let's Encrypt notifies about certificates. See README "Deploying to a server".
# COMPOSE_FILE=docker-compose.yml:deploy/docker-compose.prod.yml
# API_HOST=api-dcs.verysell.ai
# Exposes the IoT core's own interface through Caddy. Leave unset and it stays on 127.0.0.1:8090 only.
# TB_HOST=tb-dcs.verysell.ai
# ACME_EMAIL=ops@example.com

# ---- Platform Postgres ----
POSTGRES_PORT=5434
POSTGRES_DB=platform
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
# Application roles created by the initial migration
DB_APP_PASSWORD=app-dev-password
DB_ADMIN_PASSWORD=app-admin-dev-password
# Runtime role (RLS enforced) and admin role (bypass RLS; migrations, provisioning, jobs)
DATABASE_URL=postgres://app:app-dev-password@postgres:5432/platform
DATABASE_ADMIN_URL=postgres://app_admin:app-admin-dev-password@postgres:5432/platform

# ---- Redis ----
REDIS_PORT=6380
REDIS_URL=redis://redis:6379

# ---- Time zone of the simulated office (persona schedules, sweep time, reports) ----
TZ=Asia/Dubai

# ---- API ----
API_PORT=4000
API_URL=http://api:4000
API_PUBLIC_URL=http://localhost:4000
JWT_SECRET=change-me-jwt-secret-at-least-32-characters
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d
# Shared secret between ThingsBoard rule chain -> API, and API -> simulator
INTERNAL_API_TOKEN=change-me-internal-token
# Public ThingsBoard URL the browser uses for embedded dashboards
TB_PUBLIC_URL=http://localhost:8090
LOG_LEVEL=info

# ---- Simulator ----
SIMULATOR_PORT=4100
SIMULATOR_URL=http://simulator:4100
# Which tenants the simulator drives is decided per tenant in the platform console ("Simulated devices").
# Set this to a comma-separated list only to override that with a fixed list.
SIM_TENANTS=
SIM_DATASET=office-demo
# Inside compose the simulator connects to ThingsBoard MQTT at thingsboard:1883
SIM_MQTT_URL=mqtt://thingsboard:1883
SIM_TICK_MS=10000

# ---- Web ----
WEB_PORT=8081

# ---- Mail ----
MAILPIT_UI_PORT=8025
MAILPIT_SMTP_PORT=1025
SMTP_URL=smtp://mailpit:1025
MAIL_FROM=no-reply@platform.local

# ---- Dataset users (admin@, ops@, field@, finance@, viewer@ + <tenant>.demo) ----
DATASET_USER_PASSWORD=Demo1234!

# ---- Platform admin console (http://localhost:8081/admin) ----
# Created on API start; leave the password empty to disable the console login.
PLATFORM_ADMIN_EMAIL=admin@platform.local
PLATFORM_ADMIN_PASSWORD=Admin1234!
