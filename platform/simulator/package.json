{
  "name": "@platform/simulator",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Virtual devices speaking MQTT to ThingsBoard, driven by dataset personas and scenarios",
  "main": "dist/main.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "start": "node dist/main.js",
    "dev": "tsx watch src/main.ts",
    "test": "vitest run"
  },
  "dependencies": {
    "@fastify/sensible": "^6.0.5",
    "@platform/shared": "workspace:*",
    "fastify": "^5.12.3",
    "fastify-type-provider-zod": "^7.0.0",
    "mqtt": "^5.15.2",
    "pino": "^9.14.0",
    "pino-pretty": "^13.1.3",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@types/node": "^22.20.1",
    "tsx": "^4.23.13",
    "typescript": "~5.9.3",
    "vitest": "^4.0.0"
  }
}
